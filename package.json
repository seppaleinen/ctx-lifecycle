{
  "name": "ctx-lifecycle",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "context-pager OpenCode V2 plugin for ctx-lifecycle",
  "engines": {
    "bun": ">=1.0.0"
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir=dist --target=bun",
    "test": "bun test tests/",
    "test:unit": "bun test tests/unit/",
    "test:integration": "bun test tests/integration/",
    "lint": "bunx eslint src/ tests/",
    "typecheck": "tsc --noEmit",
    "verify": "tsc --noEmit && bunx eslint src/ tests/ && bun test tests/ && bun build src/index.ts --outdir=dist --target=bun"
  },
  "dependencies": {
    "@opencode/plugin": "^2.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.0.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^10.14.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.72.1"
  }
}
